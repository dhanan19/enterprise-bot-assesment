    {{- include "lab.labels" . | nindent 4 }}
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: reporter-read
  labels:
    app: reporter
    {{- include "lab.labels" . | nindent 4 }}
roleRef:
